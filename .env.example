# @raviraj87/jenkins-mcp · .env.example
# Environment variable template for Jenkins MCP configuration.
# Copyright (c) 2026 Ravi Raj · MIT License · see LICENSE

JENKINS_URL=https://jenkins.example.com
JENKINS_USERNAME=your-username
JENKINS_API_TOKEN=your-api-token
# Set to true only if you need run_script_console (dangerous).
JENKINS_ALLOW_SCRIPT_CONSOLE=false
# Prefer NODE_EXTRA_CA_CERTS=/absolute/path/to/ca.pem for an internal CA.
# Set true only to skip TLS verification (self-signed or expired controller certs).
JENKINS_NO_SSL_VERIFY=false
